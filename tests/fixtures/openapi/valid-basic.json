    "/products/{productId}": {
      "get": {
        "operationId": "getProduct",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "patch": {
        "operationId": "updateProduct",
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "responses": {
          "204": { "description": "No Content" }
        }
      }
    }
  }
